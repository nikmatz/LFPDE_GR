/* =====================================================================
   Κεφάλαιο 7 — Μετασχηματισμοί και ολοκληρώματα Fourier
   Συνοδευτικός κώδικας του βιβλίου «Μετασχηματισμοί Laplace και Fourier,
   Μερικές Διαφορικές Εξισώσεις», Ν. Ματζάκος.
   Εκτέλεση: στο wxMaxima, File > Batch File… ή  batch("maxima_ch07.mac")$
   Ο μετασχηματισμός υπολογίζεται από τον ορισμό F(w) = ∫ f(t) e^{-iwt} dt·
   δηλώνουμε με assume το πρόσημο των παραμέτρων.
   ===================================================================== */
assume(a > 0)$

/* ---------- Α. Παράδειγμα 7.5: εκθετικές συναρτήσεις ---------- */
integrate(exp(-a*t)*exp(-%i*w*t), t, 0, inf);                                   /* 1/(a+iw) */
ratsimp(integrate(exp(a*t)*exp(-%i*w*t), t, minf, 0)
      + integrate(exp(-a*t)*exp(-%i*w*t), t, 0, inf));                         /* 2a/(a²+w²) */

/* ---------- Β. Παραδείγματα 7.4 και 7.6: παλμός και γκαουσιανή ---------- */
trigsimp(demoivre(integrate(exp(-%i*w*t), t, -1, 1)));                          /* 2 sin(w)/w */
integrate(exp(-a*t^2)*exp(-%i*w*t), t, minf, inf);                              /* √(π/a) e^{-w²/(4a)} */

/* ---------- Γ. Ολοκληρώματα Fourier με το πακέτο fourie (z = ω) ---------- */
load(fourie)$
fourint(exp(-abs(x)), x);
fourintcos(exp(-2*x), x);                                                       /* Λυμένη Άσκηση 7.1 */
fourintsin(exp(-2*x), x);

/* ---------- Δ. Παράδειγμα 7.3: διπολικός παλμός ---------- */
F: ratsimp(demoivre(integrate(exp(-%i*w*t), t, 0, 1) - integrate(exp(-%i*w*t), t, -1, 0)));
ratsimp(trigreduce(F + 4*%i*sin(w/2)^2/w));                                     /* 0: F = -4i sin²(w/2)/w */
integrate(sin(x)^3/x, x, 0, inf);                                               /* π/4 */

/* ---------- Ε. Παράδειγμα 7.14: συνέλιξη και Parseval ---------- */
partfrac(4/((1 + s)^2*(1 - s)^2), s);
integrate(1/(1 + w^2)^2, w, minf, inf);                                         /* π/2 */
integrate((sin(w)/w)^2, w, minf, inf);                                          /* Παράδειγμα 7.15(β): π */

/* ---------- ΣΤ. Πρόταση 7.6: οι συντελεστές της παλμοσειράς από τον μετασχηματισμό ενός παλμού ---------- */
assume(tau > 0, T > tau)$
G(w) := 2*A*sin(w*tau/2)/w$                    /* μετασχηματισμός του παλμού ύψους A και διάρκειας τ */
c(n) := G(n*2*%pi/T)/T$                        /* c_n = G(n ω0)/T */
ratsimp(c(n));                                 /* A sin(π n τ/T)/(π n) = A d sinc(nπd) */
